' Deterministic indexed CGA/EGA/VGA tests, safe for qbs test without a terminal.
Dim cga = PC.Create(1)
PC.WriteByte(cga, 0, 27)
AssertEqual(0, PC.Point(cga, 0, 0))
AssertEqual(1, PC.Point(cga, 1, 0))
AssertEqual(2, PC.Point(cga, 2, 0))
AssertEqual(3, PC.Point(cga, 3, 0))
Dim ega = PC.Create(9)
PC.PSet(ega, 0, 0, 15)
AssertEqual(128, PC.ReadByte(ega, 0, 3))
PC.Active(ega, 1)
PC.PSet(ega, 0, 0, 6)
AssertEqual(15, PC.Point(ega, 0, 0, 0))
AssertEqual(6, PC.Point(ega, 0, 0))
Dim image = PC.Get(ega, 0, 0, 1, 1)
PC.Put(ega, image, 10, 10, "xor")
AssertEqual(6, PC.Point(ega, 10, 10))
PC.Put(ega, image, 10, 10, "xor")
AssertEqual(0, PC.Point(ega, 10, 10))
Dim vga = PC.Create(13)
PC.PSet(vga, 319, 199, 255)
PC.Dac(vga, 255, 63, 0, 21)
AssertEqual(255, PC.ReadByte(vga, 63999))
AssertEqual(16711765, PC.Rgb(vga, 255))
AssertEqual(8, PC.Modes().Count)
