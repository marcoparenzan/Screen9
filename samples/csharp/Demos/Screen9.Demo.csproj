<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The demos themselves are a library (Core/), shared with the website; this project is the console host. -->
    <Compile Remove="Core/**" />
    <ProjectReference Include="../../../src/Screen9/Screen9.csproj" />
    <ProjectReference Include="Core/Screen9.DemosCore.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
</Project>
