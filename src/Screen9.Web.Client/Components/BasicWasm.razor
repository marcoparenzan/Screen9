@* A QBasic program on the QBSharp interpreter, running in the browser (see BrowserBasic). *@
@implements IDisposable

<PixelScreen @ref="screen" />

@code {
    /// <summary>The program text.</summary>
    [Parameter, EditorRequired] public string Source { get; set; } = "";
    [Parameter] public string FileName { get; set; } = "GORILLA.BAS";

    private PixelScreen? screen;
    private readonly CancellationTokenSource cts = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || screen is null) return;
        await screen.Ready;
        await BrowserBasic.RunAsync(Source, FileName, screen, _ => { }, cts.Token); // a runtime diagnostic is already on the last presented screen
    }

    public void Dispose() => cts.Cancel();
}
