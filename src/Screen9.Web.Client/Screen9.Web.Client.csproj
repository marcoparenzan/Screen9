<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- JSHost/JSImport are browser-only, and this assembly only runs there (the server just reads its types). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Games run in the browser, in-process: no SignalR hop per frame. The server keeps the interpreters/editor. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- IL interpreter: ~28 ms per Plasma step. AOT (publish, Release only: a Debug build stays debuggable) compiles to native WASM; needs the wasm-tools workload. -->
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <ProjectReference Include="../Screen9/Screen9.csproj" />
    <ProjectReference Include="../../samples/csharp/Demos/Core/Screen9.DemosCore.csproj" />
    <ProjectReference Include="../../samples/csharp/RallyX/RallyXCore.csproj" />
    <ProjectReference Include="../../samples/csharp/Gorilla/GorillasCore.csproj" />
    <ProjectReference Include="../QBSharp.QBasic/QBSharp.QBasic.csproj" />
    <ProjectReference Include="../QBSharp.StandardLibrary/QBSharp.StandardLibrary.csproj" />
    <!-- PySharp (Python in C#), from ../../LocalFeed (see LocalFeed/README.md): 2.6.0 has RunAsync, which waits instead of blocking a thread. -->
    <PackageReference Include="PySharp.Interpreter" Version="2.6.0" />
  </ItemGroup>

</Project>
