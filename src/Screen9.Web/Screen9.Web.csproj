<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <UserSecretsId>screen9-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Screen9/Screen9.csproj" />
    <ProjectReference Include="../Screen9.Web.Client/Screen9.Web.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    <ProjectReference Include="../QBSharp.Cli/QBSharp.Cli.csproj" />
    <ProjectReference Include="../../samples/csharp/Gorilla/GorillasCore.csproj" />
    <ProjectReference Include="../../samples/csharp/RallyX/RallyXCore.csproj" />
    <ProjectReference Include="../../samples/csharp/Demos/Core/Screen9.DemosCore.csproj" />
    <ProjectReference Include="../Screen9.Scripting/Screen9.Scripting.csproj" />
    <!-- PySharp (Python in C#), from ../../LocalFeed (see LocalFeed/README.md), for the Python Gorillas page. -->
    <PackageReference Include="PySharp.Interpreter" Version="2.5.0" />
  </ItemGroup>

  <!-- Bundled, read-only samples for the "just play"/preload pages and the editor's starting file. -->
  <ItemGroup>
    <None Include="../../samples/qbsharp/Gorilla/GORILLA.BAS" Link="samples/GORILLA.BAS" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/qbsharp/hello.bas" Link="samples/hello.bas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/python/Gorilla/gorillas.py" Link="samples/gorillas.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/csharp/Gorilla/gorillas.csx" Link="samples/gorillas.csx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/csharp/Gorilla/GorillasCore.cs" Link="samples/GorillasCore.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/csharp/Demos/Core/PlasmaDemo.cs" Link="samples/PlasmaDemo.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/csharp/Demos/Core/SceneDemo.cs" Link="samples/SceneDemo.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Tailwind CSS: built by the standalone CLI (no Node/npm dependency), run with `dotnet build`/`watch`.
       Skipped, not failed, when the CLI hasn't been fetched yet (see tools/fetch-tailwind.ps1) — the
       committed wwwroot/css/app.css still serves in that case, just not freshly rebuilt. -->
  <PropertyGroup>
    <TailwindCli>$(MSBuildProjectDirectory)\.tailwind\tailwindcss.exe</TailwindCli>
  </PropertyGroup>
  <Target Name="BuildTailwindCss" BeforeTargets="BeforeBuild" Condition="Exists('$(TailwindCli)')">
    <Exec Command="&quot;$(TailwindCli)&quot; -i tailwind.css -o wwwroot/css/app.css --minify" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <Target Name="WarnMissingTailwindCss" BeforeTargets="BeforeBuild" Condition="!Exists('$(TailwindCli)')">
    <Warning Text="Tailwind CLI not found at $(TailwindCli) — run tools/fetch-tailwind.ps1 once to rebuild wwwroot/css/app.css from tailwind.css. Using the committed app.css as-is." />
  </Target>

</Project>
