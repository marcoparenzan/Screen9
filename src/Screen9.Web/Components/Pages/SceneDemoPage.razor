@page "/scene-demo"
@using Screen9.Demos

<PageTitle>Scene demo — Screen9</PageTitle>

<div class="mx-auto flex w-full max-w-4xl flex-1 flex-col gap-3 p-4">
    <h1 class="text-xl font-bold text-pc-white">Scene — the cell canvas</h1>
    <p class="text-sm text-pc-gray">
        The cell canvas — a character and two of the 16 colours per cell, origin at the top left — drawing text, a rectangle and a line, with a
        ball and a counter animated on top of a scene captured once. This is the model the engine uses for terminals; here it is drawn with the IBM
        VGA ROM font and runs in your browser (WebAssembly). In a Windows console the same code runs with <code class="text-pc-yellow">dotnet run --project samples/csharp/Demos</code>.
    </p>
    <Screen9.Web.Client.Components.SceneWasm @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
    <details class="rounded border border-pc-darkgray p-3">
        <summary class="cursor-pointer text-sm font-bold text-pc-white">The code (SceneDemo.cs)</summary>
        <pre class="mt-2 max-h-[32rem] overflow-auto text-xs text-pc-gray">@listing</pre>
    </details>
</div>

@code {
    private string listing = "";

    protected override void OnInitialized()
        => listing = File.ReadAllText(Path.Combine(AppContext.BaseDirectory, "samples", "SceneDemo.cs")); // bundled read-only, see csproj
}
