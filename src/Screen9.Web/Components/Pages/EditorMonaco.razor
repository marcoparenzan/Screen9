@page "/editor-monaco"

<PageTitle>Editor (Monaco) — Screen9</PageTitle>

<div class="mx-auto flex w-full max-w-4xl flex-1 flex-col gap-4 p-4">
    <div>
        <h1 class="text-xl font-bold text-pc-white">QBSharp editor — Monaco</h1>
        <p class="text-sm text-pc-gray">
            Run executes the editor's text (even unsaved) in your browser, with the runtime chosen by the file extension: <code class="text-pc-yellow">.bas</code> QBasic
            on QBSharp, <code class="text-pc-yellow">.py</code> Python on PySharp. The program runs on a screen below the editor (the browser's screen, keyboard and audio);
            output and errors appear in the log. Nothing you write leaves your browser: the files are kept in this browser's storage (Save).
            C# script (<code class="text-pc-yellow">.csx</code>) can be edited but runs only on the <a href="/gorillas-csx" class="text-pc-brightcyan underline hover:text-pc-yellow">server page</a>.
        </p>
    </div>

    <Screen9.Web.Client.Components.EditorMonacoWasm Samples="@samples" InitialFile="@FileParameter" @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
</div>

@code {
    private Dictionary<string, string> samples = [];

    [SupplyParameterFromQuery(Name = "file")] public string? FileParameter { get; set; }

    // The bundled read-only samples (see the csproj): the editor starts from these.
    protected override void OnInitialized()
    {
        foreach (string path in Directory.EnumerateFiles(Path.Combine(AppContext.BaseDirectory, "samples")))
            if (Screen9.Web.ScriptLanguages.IsSupported(path))
                samples[Path.GetFileName(path)] = File.ReadAllText(path);
    }
}
