@page "/gorillas-csharp"

<PageTitle>Gorillas (C#) — Screen9</PageTitle>

<div class="mx-auto flex w-full max-w-4xl flex-1 flex-col gap-3 p-4">
    <h1 class="text-xl font-bold text-pc-white">Gorillas — C#</h1>
    <p class="text-sm text-pc-gray">
        <code class="text-pc-yellow">samples/csharp/Gorilla</code>'s <code class="text-pc-yellow">GorillasGame</code>,
        unchanged, hosted here instead of in a native pixel window. Click the screen, then type.
    </p>
    <Screen9.Web.Client.Components.GorillasWasm @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
    <details class="rounded border border-pc-darkgray p-3">
        <summary class="cursor-pointer text-sm font-bold text-pc-white">The code (GorillasCore.cs)</summary>
        <pre class="mt-2 max-h-[32rem] overflow-auto text-xs text-pc-gray">@listing</pre>
    </details>
</div>

@code {
    private string listing = "";

    protected override void OnInitialized()
        => listing = File.ReadAllText(Path.Combine(AppContext.BaseDirectory, "samples", "GorillasCore.cs")); // bundled read-only, see csproj
}
